; Force the typing constraints themselves to be unsolvable: -skip-smt disables
; the refinement queries (typing queries re-enable SMT internally), so the tiny
; timeout applies only to the typing solve. alive must report that it could not
; solve the typing rather than claiming the transform is correct.
; TEST-ARGS: -skip-smt -smt-to:1
; CHECK: Could not solve typing constraints
; CHECK-NOT: Transformation seems to be correct!

Name: unsolvable typing
%a = add %x, %y
%b = zext %a
%c = trunc %b
%d = zext %c
%e = trunc %d
%f = zext %e
%g = trunc %f
%h = zext %g
%i = trunc %h
%j = zext %i
%k = trunc %j
%l = zext %k
%m = trunc %l
%r = add %m, %m
  =>
%r = shl %m, 1
